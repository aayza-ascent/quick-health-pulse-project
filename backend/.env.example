# Junction sandbox credentials.
#
# The API key is read by the FastAPI service only. It is never forwarded to the
# browser: the frontend talks exclusively to this backend, which talks to
# Junction. Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env

# Sandbox key from the Junction dashboard (Configuration -> API Keys).
JUNCTION_API_KEY=

# A Junction team belongs to a region, and the host must match it or every
# request fails with 401 "invalid token" — the same error a wrong key gives, so
# it is easy to misread. The key prefix tells you which one you have:
#
#   sk_eu_...  ->  https://api.sandbox.eu.junction.com
#   sk_us_...  ->  https://api.sandbox.us.junction.com
#
# Production drops the "sandbox." segment.
JUNCTION_BASE_URL=https://api.sandbox.eu.junction.com

# Populated by `POST /api/demo/provision`, which creates a Junction user and
# attaches a demo provider connection. Paste the returned user_id here so the
# service keeps using the same patient across restarts.
JUNCTION_USER_ID=

# Demo provider to connect. Junction's sandbox supports: apple_health_kit,
# fitbit, freestyle_libre, oura.
JUNCTION_PROVIDER=fitbit

# auto    - use Junction when a key and user id are present, else fixtures
# live    - always call Junction; fail loudly if unconfigured
# fixture - always use the deterministic local generator
HEALTH_PULSE_DATA_SOURCE=auto

# Comma-separated list of browser origins allowed to call this service.
HEALTH_PULSE_CORS_ORIGINS=http://localhost:3000
